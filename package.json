{
  "name": "quicktext-store-app",
  "productName": "ZQ Text Sandbox 8F4K2",
  "version": "1.0.0",
  "description": "A focused Windows text cleanup tool with an optional Pro unlock.",
  "main": "main.cjs",
  "author": "罗运来",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/validate-project.mjs",
    "license:keys": "node scripts/license.cjs keys",
    "license:generate": "node scripts/license.cjs generate",
    "package:win": "electron-packager . ZQTextSandbox8F4K2 --platform=win32 --arch=x64 --out=out --overwrite --asar --prune=true --ignore=^/out --ignore=^/.git --ignore=^/secrets",
    "package:msix": "powershell -ExecutionPolicy Bypass -File scripts/package-msix.ps1"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "@electron/packager": "20.3.0"
  },
  "optionalDependencies": {
    "@microsoft/winappcli": "0.6.0"
  }
}
